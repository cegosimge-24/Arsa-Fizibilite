{
  "version": "0.4",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/parcel/analyze",
      "body": [
        "district",
        "neighborhood",
        "block",
        "parcel"
      ],
      "returns": [
        "parcel",
        "zoning",
        "plan_notes",
        "market",
        "feasibility"
      ]
    },
    {
      "method": "GET",
      "path": "/api/parcel/{id}/geometry",
      "returns": [
        "geometry"
      ]
    },
    {
      "method": "GET",
      "path": "/api/zoning/{parcel_id}",
      "returns": [
        "zoning",
        "sources"
      ]
    },
    {
      "method": "POST",
      "path": "/api/feasibility",
      "body": [
        "parcelArea",
        "zoning",
        "apartmentSizes",
        "finance"
      ],
      "returns": [
        "scenarios",
        "cost",
        "revenue",
        "profit"
      ]
    }
  ]
}